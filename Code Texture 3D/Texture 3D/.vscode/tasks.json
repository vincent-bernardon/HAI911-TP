{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake",
            "type": "shell",
            "command": "qmake",
            "args": ["Texture3D.pro"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": ["-j"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "qmake",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "group": "build"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./texture3D",
            "dependsOn": "build",
            "group": "test"
        }
    ]
}